{
  "rules": {
    ".read": false,
    ".write": false,
    "online": {
      ".indexOn": [
        "at"
      ],
      ".read": "query.orderByChild === 'at' && query.limitToLast <= 5000",
      "$id": {
        ".write": "$id.matches(/^[A-Za-z0-9]{20}$/) && newData.exists()",
        ".validate": "newData.hasChildren(['at'])",
        "at": {
          ".validate": "newData.val() === now"
        },
        "game": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      "allTime": {
        ".read": true,
        ".write": "newData.exists()",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "days": {
        "$day": {
          ".read": true,
          ".write": "newData.exists() && $day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "draw": {
      "open": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{6}$/) && (newData.exists() ? newData.parent().parent().child('rooms').child($code).child('p').child(auth.uid).exists() : (!data.exists() || data.child('at').val() < now - 60000 || root.child('draw/rooms').child($code).child('p').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['n', 'm', 'ph', 'at'])",
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "m": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 10"
          },
          "ph": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'play'"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rooms": {
        "$code": {
          ".write": "auth != null && !newData.exists() && data.child('p').child(auth.uid).exists()",
          ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
          "s": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || newData.parent().child('p').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['rounds', 'time', 'hints', 'max', 'pub'])",
            "rounds": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 240"
            },
            "hints": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "max": {
              ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 10"
            },
            "pub": {
              ".validate": "newData.isBoolean()"
            },
            "only": {
              ".validate": "newData.isBoolean()"
            },
            "words": {
              ".validate": "newData.isString() && newData.val().length <= 4000"
            },
            "$other": {
              ".validate": false
            }
          },
          "p": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['n', 'on']) && newData.parent().parent().child('s').exists()",
              "n": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
              },
              "on": {
                ".validate": "newData.isBoolean()"
              },
              "j": {
                ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "g": {
            ".read": "auth != null",
            ".write": "auth != null && newData.parent().child('p').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['ph', 't', 'tk'])"
          },
          "ink": {
            ".read": "auth != null",
            ".write": "auth != null && newData.parent().child('p').child(auth.uid).exists()",
            "$t": {
              "$k": {
                ".validate": "newData.hasChildren(['s', 'c']) && newData.child('c').isNumber() && (!newData.child('p').exists() || (newData.child('p').isString() && newData.child('p').val().length <= 4000))"
              }
            }
          },
          "chat": {
            ".read": "auth != null",
            "$k": {
              ".write": "auth != null && !data.exists() && newData.parent().parent().child('p').child(auth.uid).exists()",
              ".validate": "newData.hasChildren(['u', 'n', 'x', 'a']) && newData.child('u').val() === auth.uid && newData.child('n').isString() && newData.child('n').val().length <= 20 && newData.child('x').isString() && newData.child('x').val().length >= 1 && newData.child('x').val().length <= 100 && newData.child('a').val() === now"
            }
          },
          "w": {
            "$t": {
              ".read": "auth != null && (root.child('draw/rooms/' + $code + '/g/ph').val() === 'show' || root.child('draw/rooms/' + $code + '/g/ph').val() === 'end' || root.child('draw/rooms/' + $code + '/g/ph').val() === 'lobby' || root.child('draw/rooms/' + $code + '/g/tk').val() !== $t)",
              ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('draw/rooms/' + $code + '/g/d').val() === auth.uid && root.child('draw/rooms/' + $code + '/g/ph').val() === 'pick' && root.child('draw/rooms/' + $code + '/g/tk').val() === $t) || (!newData.exists() && root.child('draw/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('draw/rooms/' + $code + '/g/tk').val() !== $t))",
              ".validate": "newData.hasChildren(['k', 'd']) && newData.child('k').isString() && newData.child('k').val().matches(/^[a-z0-9]{1,40}$/) && newData.child('d').isString() && newData.child('d').val().length <= 40"
            }
          },
          "near": {
            "$t": {
              ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('draw/rooms/' + $code + '/g/d').val() === auth.uid && root.child('draw/rooms/' + $code + '/g/ph').val() === 'pick' && root.child('draw/rooms/' + $code + '/g/tk').val() === $t) || (!newData.exists() && root.child('draw/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('draw/rooms/' + $code + '/g/tk').val() !== $t))"
            }
          },
          "hit": {
            "$t": {
              ".write": "auth != null && (!newData.exists() && root.child('draw/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('draw/rooms/' + $code + '/g/tk').val() !== $t)",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('draw/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('draw/rooms/' + $code + '/g/ph').val() === 'draw' && root.child('draw/rooms/' + $code + '/g/tk').val() === $t && root.child('draw/rooms/' + $code + '/g/d').val() !== auth.uid",
                ".validate": "newData.isString() && newData.val() === root.child('draw/rooms/' + $code + '/w/' + $t + '/k').val()"
              }
            }
          },
          "close": {
            "$t": {
              ".write": "auth != null && (!newData.exists() && root.child('draw/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('draw/rooms/' + $code + '/g/tk').val() !== $t)",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && newData.exists() && root.child('draw/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('draw/rooms/' + $code + '/g/ph').val() === 'draw' && root.child('draw/rooms/' + $code + '/g/tk').val() === $t",
                ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,40}$/) && root.child('draw/rooms/' + $code + '/near/' + $t + '/' + newData.val() + '').exists()"
              }
            }
          }
        }
      }
    },
    "tele": {
      "rooms": {
        "$code": {
          ".write": "auth != null && !newData.exists() && data.child('p').child(auth.uid).exists()",
          ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
          "s": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || newData.parent().child('p').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['draw', 'write', 'max', 'full'])",
            "draw": {
              ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 240"
            },
            "write": {
              ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 120"
            },
            "max": {
              ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 12"
            },
            "full": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "p": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['n', 'on']) && newData.parent().parent().child('s').exists()",
              "n": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
              },
              "on": {
                ".validate": "newData.isBoolean()"
              },
              "j": {
                ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "g": {
            ".read": "auth != null",
            ".write": "auth != null && newData.parent().child('p').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['ph', 't', 'tk', 'r', 'rk'])",
            "ph": {
              ".validate": "newData.val() === 'lobby' || newData.val() === 'play' || newData.val() === 'show' || newData.val() === 'end'"
            }
          },
          "e": {
            ".read": "auth != null",
            "$t": {
              ".write": "auth != null && !newData.exists() && root.child('tele/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('tele/rooms/' + $code + '/g/tk').val() !== $t",
              "$c": {
                "$r": {
                  ".write": "auth != null && root.child('tele/rooms/' + $code + '/p/' + auth.uid).exists() && newData.exists() && root.child('tele/rooms/' + $code + '/g/ph').val() === 'play' && root.child('tele/rooms/' + $code + '/g/tk').val() === $t && ((root.child('tele/rooms/' + $code + '/g/rk').val() === $r && newData.child('u').val() === auth.uid && (!data.exists() || data.child('u').val() === auth.uid)) || ($r === '0' && !data.exists() && newData.child('auto').val() === true))",
                  ".validate": "newData.hasChildren(['u', 'k']) && $c.matches(/^[0-9]{1,2}$/) && $r.matches(/^[0-9]{1,2}$/)",
                  "u": {
                    ".validate": "newData.isString() && newData.val().length <= 128"
                  },
                  "k": {
                    ".validate": "newData.val() === 'w' || newData.val() === 'd'"
                  },
                  "x": {
                    ".validate": "newData.isString() && newData.val().length <= 80"
                  },
                  "auto": {
                    ".validate": "newData.val() === true"
                  },
                  "d": {
                    "$i": {
                      ".validate": "$i.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['s', 'c']) && newData.child('c').isNumber() && (!newData.child('p').exists() || (newData.child('p').isString() && newData.child('p').val().length <= 4000))"
                    }
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              }
            }
          },
          "sub": {
            ".read": "auth != null",
            "$t": {
              ".write": "auth != null && !newData.exists() && root.child('tele/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('tele/rooms/' + $code + '/g/tk').val() !== $t",
              "$r": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && root.child('tele/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('tele/rooms/' + $code + '/g/tk').val() === $t",
                  ".validate": "newData.val() === true"
                }
              }
            }
          },
          "like": {
            ".read": "auth != null",
            "$t": {
              ".write": "auth != null && !newData.exists() && root.child('tele/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('tele/rooms/' + $code + '/g/tk').val() !== $t",
              "$k": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && root.child('tele/rooms/' + $code + '/p/' + auth.uid).exists() && root.child('tele/rooms/' + $code + '/g/tk').val() === $t && (root.child('tele/rooms/' + $code + '/g/ph').val() === 'show' || root.child('tele/rooms/' + $code + '/g/ph').val() === 'end')",
                  ".validate": "$k.matches(/^[0-9]{1,2}-[0-9]{1,2}$/) && newData.val() === true"
                }
              }
            }
          },
          "chat": {
            ".read": "auth != null",
            "$k": {
              ".write": "auth != null && !data.exists() && newData.parent().parent().child('p').child(auth.uid).exists()",
              ".validate": "newData.hasChildren(['u', 'n', 'x', 'a']) && newData.child('u').val() === auth.uid && newData.child('n').isString() && newData.child('n').val().length <= 20 && newData.child('x').isString() && newData.child('x').val().length >= 1 && newData.child('x').val().length <= 100 && newData.child('a').val() === now"
            }
          }
        }
      }
    },
    "plays": {
      "allTime": {
        ".read": true,
        "$slug": {
          ".write": "newData.exists() && $slug.matches(/^[a-z0-9-]{1,40}$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "days": {
        "$day": {
          ".read": true,
          "$slug": {
            ".write": "newData.exists() && $slug.matches(/^[a-z0-9-]{1,40}$/) && $day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        }
      }
    }
  }
}
