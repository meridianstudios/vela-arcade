rules_version = '2';

// Vela Arcade security rules, for online rooms (public/games/_shared/rooms.js).
//
// Players are anonymous auth users. A room is addressed by its six-character
// code, so knowing the code is what grants access, same model as Wildcard.
//
// Game logic runs in the browser and moves are trusted (honest client). The
// exception is hidden information: rooms/{code}/private/{uid} is readable only
// by its owner, so a game like Sea Battle keeps each fleet private and has the
// defender's own client report whether a shot hit.
//
// No get() or exists() anywhere: each one is a billed read on every access it
// guards, and on Wildcard that alone burned through the free tier's daily
// quota and took the game down.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Staff. Owners are listed in owners/{uid}, written only from the Firebase
    // console or an admin token, never from the site; an owner counts as a
    // moderator and can make or remove moderators (mods/{uid}). These
    // exists() checks are billed reads, so they only guard rare actions: a new
    // best and staff changing something.
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }
    function isMod() {
      return signedIn() && (exists(/databases/$(database)/documents/mods/$(request.auth.uid)) || isOwner());
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    // Roles are public, so a profile can say who is staff. Listing them all
    // is for staff.
    match /owners/{uid} {
      allow get: if true;
      allow list: if isMod();
    }
    match /mods/{uid} {
      allow get: if true;
      allow list: if isMod();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isOwner();
    }

    // A banned account can no longer post to leaderboards or save bests.
    match /bans/{uid} {
      allow get, list: if isMod();
      allow create: if isMod()
        && request.resource.data.keys().hasOnly(['name', 'at', 'by'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isMod();
    }

    match /rooms/{code} {
      // get, not read: read would also allow listing the collection, which
      // hands out every open room code and bills a read per room.
      allow get: if signedIn();

      // The creator seats themselves as host and nobody else.
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.seats.size() == 1
        && request.resource.data.seats[0] == request.auth.uid
        && request.resource.data.maxSeats is int
        && request.resource.data.maxSeats >= 1
        && request.resource.data.maxSeats <= 10;

      // A seated player acting, or a newcomer appending themselves to a lobby.
      // Nobody may change the game, the host or the seat limit.
      allow update: if signedIn()
        && request.resource.data.game == resource.data.game
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.maxSeats == resource.data.maxSeats
        && (
          request.auth.uid in resource.data.seats
          || (
            resource.data.phase == 'lobby'
            && request.resource.data.seats.size() == resource.data.seats.size() + 1
            && request.resource.data.seats.size() <= resource.data.maxSeats
            && !(request.auth.uid in resource.data.seats)
            && request.auth.uid in request.resource.data.seats
          )
        );

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      // Hidden per-player information. Owner only.
      match /private/{uid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Saved bests for a signed-in (non-anonymous) player, src/account.js.
    // Only the owner can see or change them; anonymous room accounts cannot.
    match /players/{uid} {
      function owner() {
        return signedIn() && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      allow get: if owner();
      allow create, update: if owner() && notBanned()
        && request.resource.data.keys().hasOnly(['bests', 'updatedAt'])
        && request.resource.data.bests is map
        && request.resource.data.bests.size() <= 500;
      allow delete: if owner();
    }

    // How an account looks to everyone else: a display name, an avatar (a
    // game's icon, or '' for the first letter), a colour, up to three tags,
    // a name colour and a favourite game. The same checks guard the copy on
    // leaderboard entries. Display names get the username blocklist, after
    // the same flattening src/account.js does. (badge is the single tag
    // accounts had before tags; it is only ever removed now.)
    function okSlug(v) {
      return v is string && v.matches('^[a-z0-9-]{0,40}$');
    }
    function okColor(v) {
      return v in ['#ea5426', '#2d89ef', '#00a300', '#b91d47', '#7e3878', '#e3a21a', '#00aba9', '#5e6066', '#000000'];
    }
    // A tag is a game (a top 10 placing, checked where it is shown) or a
    // staff tag.
    function okTags(d) {
      return !('tags' in d) || (d.tags is list && d.tags.size() <= 3
        && (d.tags.size() < 1 || okTag(d.tags[0]))
        && (d.tags.size() < 2 || okTag(d.tags[1]))
        && (d.tags.size() < 3 || okTag(d.tags[2])));
    }
    function okTag(v) {
      return v is string && v.matches('^[a-z0-9-]{1,40}$');
    }
    function okFlair(d) {
      return !('flair' in d) || d.flair in ['', 'orange'];
    }
    // The owner's tags, the Vela picture, black and an orange name are the
    // owner's alone; the Moderator tag is staff's. Checked only when one is
    // used, so nobody else's saves pay for the exists() reads.
    function ownerOnly(d) {
      return ('tags' in d && d.tags.hasAny(['owner', 'founder', 'developer']))
        || d.get('avatar', '') == 'vela' || d.get('color', '') == '#000000' || d.get('flair', '') != '';
    }
    function earned(d, uid) {
      return (!ownerOnly(d) || exists(/databases/$(database)/documents/owners/$(uid)))
        && (!('tags' in d) || !d.tags.hasAny(['mod'])
          || exists(/databases/$(database)/documents/mods/$(uid))
          || exists(/databases/$(database)/documents/owners/$(uid)));
    }
    function okDisplay(v) {
      return v is string && v.size() >= 2 && v.size() <= 20
        && v.matches('^[A-Za-z0-9_]+([ .-][A-Za-z0-9_]+)*$')
        && !v.lower().replace('[^a-z0-9]', '').replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's')
          .matches('.*(fuck|shit|cunt|nigg|fag|bitch|whore|slut|rape|nazi|hitler|penis|vagina|porn|dick|cock|pussy|retard|kys).*');
    }

    // Public profiles, keyed by the lowercase username: anyone can look one
    // up by name, only the account itself writes it, a moderator can wipe it.
    match /profiles/{id} {
      function me() {
        return signedIn()
          && request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.email == id + '@players.invalid';
      }
      function look(d) {
        return okDisplay(d.display) && okSlug(d.avatar) && okColor(d.color) && okSlug(d.get('badge', '')) && okSlug(d.fav)
          && okTags(d) && okFlair(d)
          && d.bests is map && d.bests.size() <= 500
          && d.updatedAt == request.time
          && earned(d, d.uid);
      }
      // cleared: records an owner removed, by game, with the score removed;
      // the account's own device will not post that score again.
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'name', 'display', 'avatar', 'color', 'badge', 'tags', 'flair', 'fav', 'bests', 'cleared', 'joined', 'updatedAt'])
          && d.uid == request.auth.uid
          && d.name is string && d.name.lower() == id
          && look(d)
          && d.joined is timestamp && d.joined <= request.time;
      }
      allow get: if true;
      allow create: if me() && valid() && !('cleared' in request.resource.data) && notBanned();
      allow update: if me() && valid() && notBanned()
        && request.resource.data.joined == resource.data.joined
        && request.resource.data.get('cleared', {}) == resource.data.get('cleared', {});
      // An owner renames, restyles, or removes a record from anyone.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display', 'avatar', 'color', 'badge', 'tags', 'flair', 'fav', 'bests', 'cleared', 'updatedAt'])
        && look(request.resource.data)
        && request.resource.data.get('cleared', {}) is map;
      allow delete: if me() || isMod();
    }

    // Global leaderboards, one entry per account per game, src/account.js.
    // Anyone can read the top of a board (capped so a query can't run up the
    // bill). Only a username account writes, only its own entry, only under
    // its own name, and a score can only go up. An entry carries a copy of
    // the account's look so showing a board costs no extra reads.
    match /boards/{slug}/scores/{uid} {
      function account() {
        return signedIn() && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.email.matches('^[a-z0-9_]{3,16}@players[.]invalid$');
      }
      function validEntry() {
        let d = request.resource.data;
        return slug.matches('^[a-z0-9-]{1,40}$')
          && d.keys().hasOnly(['name', 'score', 'at', 'display', 'avatar', 'color', 'badge', 'tags', 'flair'])
          && d.name is string
          && d.name.lower() + '@players.invalid' == request.auth.token.email
          && d.score is number && d.score > 0 && d.score < 1000000000000
          && d.at == request.time
          && (!('display' in d) || okDisplay(d.display))
          && (!('avatar' in d) || okSlug(d.avatar))
          && (!('color' in d) || okColor(d.color))
          && (!('badge' in d) || okSlug(d.badge))
          && okTags(d) && okFlair(d)
          && earned(d, uid);
      }
      allow get: if true;
      allow list: if request.query.limit <= 25;
      allow create: if account() && validEntry() && notBanned();
      // A higher score, or the same score with a new look.
      allow update: if account() && validEntry() && request.resource.data.score >= resource.data.score && notBanned();
      // Moderators strip the look off an entry (an inappropriate display name).
      allow update: if isMod()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display', 'avatar', 'color', 'badge', 'tags', 'flair'])
        && request.resource.data.keys().hasOnly(['name', 'score', 'at']);
      // An owner can also set it, when renaming someone or taking a tag away.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display', 'avatar', 'color', 'badge', 'tags', 'flair'])
        && okTags(request.resource.data) && okFlair(request.resource.data)
        && earned(request.resource.data, uid)
        && (!('display' in request.resource.data) || okDisplay(request.resource.data.display))
        && (!('avatar' in request.resource.data) || okSlug(request.resource.data.avatar))
        && (!('color' in request.resource.data) || okColor(request.resource.data.color))
        && (!('badge' in request.resource.data) || okSlug(request.resource.data.badge));
      // The account deleting itself, or a moderator removing an entry (an
      // inappropriate name, an impossible score).
      allow delete: if account() || isMod();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
