rules_version = '2';

// Vela Arcade security rules, for online rooms (public/games/_shared/rooms.js).
//
// Players are anonymous auth users. A room is addressed by its six-character
// code, so knowing the code is what grants access, same model as Wildcard.
//
// Game logic runs in the browser and moves are trusted (honest client). The
// exception is hidden information: rooms/{code}/private/{uid} is readable only
// by its owner, so a game like Sea Battle keeps each fleet private and has the
// defender's own client report whether a shot hit.
//
// No get() or exists() anywhere: each one is a billed read on every access it
// guards, and on Wildcard that alone burned through the free tier's daily
// quota and took the game down.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /rooms/{code} {
      // get, not read: read would also allow listing the collection, which
      // hands out every open room code and bills a read per room.
      allow get: if signedIn();

      // The creator seats themselves as host and nobody else.
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.seats.size() == 1
        && request.resource.data.seats[0] == request.auth.uid
        && request.resource.data.maxSeats is int
        && request.resource.data.maxSeats >= 1
        && request.resource.data.maxSeats <= 10;

      // A seated player acting, or a newcomer appending themselves to a lobby.
      // Nobody may change the game, the host or the seat limit.
      allow update: if signedIn()
        && request.resource.data.game == resource.data.game
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.maxSeats == resource.data.maxSeats
        && (
          request.auth.uid in resource.data.seats
          || (
            resource.data.phase == 'lobby'
            && request.resource.data.seats.size() == resource.data.seats.size() + 1
            && request.resource.data.seats.size() <= resource.data.maxSeats
            && !(request.auth.uid in resource.data.seats)
            && request.auth.uid in request.resource.data.seats
          )
        );

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      // Hidden per-player information. Owner only.
      match /private/{uid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Saved bests for a signed-in (non-anonymous) player, src/account.js.
    // Only the owner can see or change them; anonymous room accounts cannot.
    match /players/{uid} {
      function owner() {
        return signedIn() && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      allow get: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['bests', 'updatedAt'])
        && request.resource.data.bests is map
        && request.resource.data.bests.size() <= 500;
    }

    // Global leaderboards, one entry per account per game, src/account.js.
    // Anyone can read the top of a board (capped so a query can't run up the
    // bill). Only a username account writes, only its own entry, only under
    // its own name, and a score can only go up.
    match /boards/{slug}/scores/{uid} {
      function account() {
        return signedIn() && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.email.matches('^[a-z0-9_]{3,16}@players[.]invalid$');
      }
      function validEntry() {
        let d = request.resource.data;
        return slug.matches('^[a-z0-9-]{1,40}$')
          && d.keys().hasOnly(['name', 'score', 'at'])
          && d.name is string
          && d.name.lower() + '@players.invalid' == request.auth.token.email
          && d.score is number && d.score > 0 && d.score < 1000000000000
          && d.at == request.time;
      }
      allow get: if true;
      allow list: if request.query.limit <= 25;
      allow create: if account() && validEntry();
      allow update: if account() && validEntry() && request.resource.data.score > resource.data.score;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
